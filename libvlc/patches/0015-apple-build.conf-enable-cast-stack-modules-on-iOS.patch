From 820da5610049c3d48db8407fd61006fdfb73d180 Mon Sep 17 00:00:00 2001
From: VLCKit Aloha Release <devnull@alohabrowser.com>
Date: Fri, 15 May 2026 12:33:02 +0300
Subject: [PATCH] apple/build.conf: enable Cast + audio/codec stack on iOS

---
 extras/package/apple/build.conf | 22 +++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/extras/package/apple/build.conf b/extras/package/apple/build.conf
index e64aa3a42d..6a71af5994 100644
--- a/extras/package/apple/build.conf
+++ b/extras/package/apple/build.conf
@@ -91,6 +91,15 @@ export VLC_CONTRIB_OPTIONS_MACOSX=(
 export VLC_CONTRIB_OPTIONS_IOS=(
     --disable-aom
     --disable-rav1e
+    --disable-protobuf
+    --enable-microdns
+    --enable-upnp
+    --enable-mpg123
+    --enable-dvbpsi
+    --enable-gcrypt
+    --enable-live555
+    --enable-ffmpeg
+    --enable-vorbis
 )

 # Additional contrib bootstrap options for tvOS
@@ -170,7 +178,19 @@ export VLC_CONFIG_OPTIONS_BASE=(
 export VLC_CONFIG_OPTIONS_MACOSX=()

 # Additional configure options for iOS
-export VLC_CONFIG_OPTIONS_IOS=()
+#
+# Cast + audio stack — forced ON (libvlc's "auto" detection occasionally
+# disables modules when pkg-config doesn't match the contrib install path
+# perfectly, which silently breaks Cast and audio playback at runtime).
+export VLC_CONFIG_OPTIONS_IOS=(
+    --disable-chromecast
+    --enable-live555
+    --enable-libgcrypt
+    --enable-vpx
+    --enable-mpg123
+    --enable-microdns
+    --enable-upnp
+)
 
 # Additional configure options for tvOS
 export VLC_CONFIG_OPTIONS_TVOS=()
